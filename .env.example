# Backend values. The frontend/proxy and ORIGIN must use the same origin.
HOST=127.0.0.1
PORT=18600
ORIGIN=http://localhost:8080
NICKNAME_ONLY=1
RA2_NETWORK_MIN_MS=60
RA2_NETWORK_MAX_MS=200
RA2_NETWORK_FALLBACK_MS=133
# Optional, for the legacy account mode only:
# DATA_DIR=/var/lib/winlife-ra2web

# Caddy example:
RA2_SITE_ADDRESS=:8080
RA2_SITE_ROOT=/absolute/path/to/prepared-client

# Version-bound build tools:
# RA2_UPSTREAM_DIR=/absolute/path/to/ra2web-upstream
# RA2_LAN_ORIGIN=https://lan-game.example.com
# RA2_PUBLIC_ORIGIN=https://game.example.com
# RA2_SITE_KIND=lan
